"cD" = (/obj/ViltrumConsole/Reactor,/turf/ViltrumFloor,/area/CityInterior)
"cE" = (/obj/ViltrumConsole{name = "Aqueduct pressure station"; status_text = "Reservoir channel runs north-south. Use the southern and northern crossings. Residential terraces east; training grounds south."},/turf/ViltrumFloor,/area/CityInterior)
"cF" = (/obj/ViltrumConsole{name = "Civic exchange"; status_text = "Civic exchange and public meeting halls. Equipment gallery west, communal food hall east. Forum east; residential terraces north."},/turf/ViltrumFloor,/area/CityInterior)
"cG" = (/obj/ViltrumConsole{name = "Cliff service records"; status_text = "Eastern maintenance passage. Science enclave west; energy works south. Cliff terrace loop open."},/turf/ViltrumFloor,/area/CityInterior)
"cH" = (/obj/ViltrumConsole{name = "Defense command directory"; status_text = "Twin defense wings face the parade court. Palace south; polar survey west; preserve east."},/turf/ViltrumFloor,/area/CityInterior)
"cI" = (/obj/ViltrumConsole{name = "Fabrication orders"; status_text = "Precision hall west; repairs east; freight warehouse south. Open service court connects the spaceport and energy works."},/turf/ViltrumFloor,/area/CityInterior)
"cJ" = (/obj/ViltrumConsole{name = "Freight dispatch"; status_text = "Clear freight apron east. Imperial terminal is east along either perimeter route. Maintenance south. Hangars are public staging interiors."},/turf/ViltrumFloor,/area/CityInterior)
"cK" = (/obj/ViltrumConsole{name = "Imperial directory"; status_text = "Audience hall and offices. South: forum and spaceport. West: residences. East: research enclave. Both outer terraces bypass the hall."},/turf/ViltrumFloor,/area/CityInterior)
"cL" = (/obj/ViltrumConsole{name = "Planetary grid diagnostics"; status_text = "Generator service court north. Research northwest; fabrication southwest. Grid diagnostics nominal. Keep generator approaches clear."},/turf/ViltrumFloor,/area/CityInterior)
"cM" = (/obj/ViltrumConsole{name = "Polar survey record"; status_text = "Ancient strata exposed beneath the escarpment. Survey chamber open. Citadel east; beacon west."},/turf/ViltrumFloor,/area/CityInterior)
"cN" = (/obj/ViltrumConsole{name = "Recovered research log"; status_text = "Archive fragment: the eastern array was evacuated before the last polar storm. Two laboratory wings remain accessible around the open court."},/turf/ViltrumFloor,/area/CityInterior)
"cO" = (/obj/ViltrumConsole{name = "Research records"; status_text = "Civil research, medical observation and the scientific archive. Medical laboratory east, archive south. Energy works southeast."},/turf/ViltrumFloor,/area/CityInterior)
"cP" = (/obj/ViltrumConsole{name = "Southern relay"; status_text = "Polar relay synchronized. Follow the coast west to the landing apron, or north toward fabrication."},/turf/ViltrumFloor,/area/CityInterior)
"cQ" = (/obj/ViltrumConsole{name = "Terrace services"; status_text = "Communal residences north; clinic and dining south. Palace east; civic market south. Public rooms use open arches."},/turf/ViltrumFloor,/area/CityInterior)
"cR" = (/obj/ViltrumConsole{name = "Training course"; status_text = "Central field: fifty tiles square. The outer loop remains clear for endurance running. Forum east; badlands south."},/turf/ViltrumFloor,/area/CityInterior)
"cS" = (/obj/ViltrumConsole{name = "War college directory"; status_text = "Arena south: four open exits and a 48 by 48 clear combat floor. Spectator circulation runs around the perimeter. Barracks east."},/turf/ViltrumFloor,/area/CityInterior)
