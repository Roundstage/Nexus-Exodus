"as" = (/obj/ViltrumConsole{name = "Aqueduct pressure station"; status_text = "Reservoir channel runs north-south. Use the southern and northern crossings. Residential terraces east; training grounds south."},/turf/ViltrumFloor,/area/Viltrum)
"at" = (/obj/ViltrumConsole{name = "Arrival concourse directory"},/turf/ViltrumFloor,/area/Viltrum)
"au" = (/obj/ViltrumConsole{name = "Civic exchange"; status_text = "Civic exchange and public meeting halls. Equipment gallery west, communal food hall east. Forum east; residential terraces north."},/turf/ViltrumFloor,/area/Viltrum)
"av" = (/obj/ViltrumConsole{name = "Civic market"; status_text = "Civic market. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aw" = (/obj/ViltrumConsole{name = "Cliff service records"; status_text = "Eastern maintenance passage. Science enclave west; energy works south. Cliff terrace loop open."},/turf/ViltrumFloor,/area/Viltrum)
"ax" = (/obj/ViltrumConsole{name = "Defense command directory"; status_text = "Twin defense wings face the parade court. Palace south; polar survey west; preserve east."},/turf/ViltrumFloor,/area/Viltrum)
"ay" = (/obj/ViltrumConsole{name = "Departure concourse directory"; status_text = "Landing apron: south at 250,78. Use normal planetary liftoff from the surface. Forum and archive: north. Both outer terraces remain open."},/turf/ViltrumFloor,/area/Viltrum)
"az" = (/obj/ViltrumConsole{name = "Fabrication district"; status_text = "Fabrication district. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aA" = (/obj/ViltrumConsole{name = "Fabrication orders"; status_text = "Precision hall west; repairs east; freight warehouse south. Open service court connects the spaceport and energy works."},/turf/ViltrumFloor/Structural,/area/Viltrum)
"aB" = (/obj/ViltrumConsole{name = "Freight dispatch"; status_text = "Clear freight apron east. Imperial terminal is east along either perimeter route. Maintenance south. Hangars are public staging interiors."},/turf/ViltrumDistrictFloor/Grate,/area/Viltrum)
"aC" = (/obj/ViltrumConsole{name = "Grand training grounds"; status_text = "Grand training grounds. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aD" = (/obj/ViltrumConsole{name = "Imperial directory"; status_text = "Audience hall and offices. South: forum and spaceport. West: residences. East: research enclave. Both outer terraces bypass the hall."},/turf/ViltrumDistrictFloor/Palace,/area/Viltrum)
"aE" = (/obj/ViltrumConsole{name = "Imperial palace precinct"; status_text = "Imperial palace precinct. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumFloor/Road,/area/Viltrum)
"aF" = (/obj/ViltrumConsole{name = "Northwest beacon"; status_text = "Coastal beacon online. Two causeways lead east to the polar route and the defense citadel."},/turf/ViltrumFloor/Road,/area/Viltrum)
"aG" = (/obj/ViltrumConsole{name = "Planetary energy works"; status_text = "Planetary energy works. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aH" = (/obj/ViltrumConsole{name = "Planetary grid diagnostics"; status_text = "Generator service court north. Research northwest; fabrication southwest. Grid diagnostics nominal. Keep generator approaches clear."},/turf/ViltrumFloor,/area/Viltrum)
"aI" = (/obj/ViltrumConsole{name = "Polar survey record"; status_text = "Ancient strata exposed beneath the escarpment. Survey chamber open. Citadel east; beacon west."},/turf/ViltrumFloor,/area/Viltrum)
"aJ" = (/obj/ViltrumConsole{name = "Public archive directory"; status_text = "Welcome to the capital archive. Forum south; palace precinct north; transit terminal south along the imperial axis."},/turf/ViltrumFloor,/area/Viltrum)
"aK" = (/obj/ViltrumConsole{name = "Recovered research log"; status_text = "Archive fragment: the eastern array was evacuated before the last polar storm. Two laboratory wings remain accessible around the open court."},/turf/ViltrumFloor,/area/Viltrum)
"aL" = (/obj/ViltrumConsole{name = "Research records"; status_text = "Civil research, medical observation and the scientific archive. Medical laboratory east, archive south. Energy works southeast."},/turf/ViltrumDistrictFloor/Laboratory,/area/Viltrum)
"aM" = (/obj/ViltrumConsole{name = "Residential terraces"; status_text = "Residential terraces. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aN" = (/obj/ViltrumConsole{name = "Science enclave"; status_text = "Science enclave. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aO" = (/obj/ViltrumConsole{name = "Shipyard approach"; status_text = "Shipyard approach. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumGround,/area/Viltrum)
"aP" = (/obj/ViltrumConsole{name = "Southern relay"; status_text = "Polar relay synchronized. Follow the coast west to the landing apron, or north toward fabrication."},/turf/ViltrumFloor,/area/Viltrum)
"aQ" = (/obj/ViltrumConsole{name = "Terrace services"; status_text = "Communal residences north; clinic and dining south. Palace east; civic market south. Public rooms use open arches."},/turf/ViltrumFloor,/area/Viltrum)
"aR" = (/obj/ViltrumConsole{name = "Training course"; status_text = "Central field: fifty tiles square. The outer loop remains clear for endurance running. Forum east; badlands south."},/turf/ViltrumFloor,/area/Viltrum)
"aS" = (/obj/ViltrumConsole{name = "War college and arena"; status_text = "War college and arena. Both perimeter boulevards lead back toward the capital forum at 250,250 and planet arrival at 250,78."},/turf/ViltrumFloor,/area/Viltrum)
"aT" = (/obj/ViltrumConsole{name = "War college directory"; status_text = "Arena south: four open exits and a 48 by 48 clear combat floor. Spectator circulation runs around the perimeter. Barracks east."},/turf/ViltrumFloor,/area/Viltrum)
