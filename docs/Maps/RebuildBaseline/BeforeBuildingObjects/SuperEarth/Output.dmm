"aa" = (/obj/EarthDirectory{directions_text = "North and south piers lead to the waterfront. Warehouse west; neighborhood stores farther inland. Western city via the northern crossings."; name = "Harbor dispatch"},/turf/EarthFloor/Grate,/area/SuperEarth)
"ab" = (/obj/EarthDirectory{directions_text = "Northern island station. Return south by either crossing. Snow and sea-ice surveys operate around the island perimeter."; name = "Arctic field log"},/turf/EarthFloor/Clinic,/area/SuperEarth)
"ac" = (/obj/EarthDirectory{directions_text = "Public wards north and south. Reception is through the open central corridor. Arrival park north; pharmacy across the road."; name = "Hospital directory"},/turf/EarthFloor/Clinic,/area/SuperEarth)
"ad" = (/obj/EarthDirectory{directions_text = "South: arrival park and western city. East: farms and the northern crossings. Keep the coastal walk clear."; name = "Coastal route board"},/turf/EarthFloor/Sidewalk,/area/SuperEarth)
"ae" = (/obj/EarthDirectory{directions_text = "Town hall and civic square. Hospital northwest; shops south; garage southwest. River crossings connect both banks."; name = "Civic district routes"},/turf/EarthFloor/Sidewalk,/area/SuperEarth)
"af" = (/obj/EarthDirectory{directions_text = "Trading hall and farms. The waterfall and its green banks lie east. West and east bridges return to the western city; the coastal road circles the desert."; name = "Oasis town routes"},/turf/EarthFloor,/area/SuperEarth)
"ag" = (/obj/EarthDirectory{directions_text = "Welcome to the western city. Hospital south; residential streets north; civic center southeast. The open lawn east is reserved for planetary arrivals."; name = "Arrival park routes"},/turf/EarthFloor/Sidewalk,/area/SuperEarth)
