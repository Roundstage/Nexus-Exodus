proc/getNexusOpenCombatIcon(library_name)
	if(!library_name) return
	return nexus_open_combat_effect_icons[lowertext("[library_name]")]

proc/getNexusShonenSound(category)
	if(!category) return
	var/list/category_sounds = nexus_shonen_sound_bank[lowertext("[category]")]
	if(!islist(category_sounds) || !category_sounds.len) return
	return pick(category_sounds)

proc/showNexusOpenCombatEffect(atom/target, library_name, effect_state, effect_scale = 1, effect_color, effect_alpha = 255, effect_blend_mode = BLEND_ADD, hold_ticks = 7, growth = 0.2)
	set waitfor = 0
	if(!target || !target.base_loc() || !library_name || !effect_state) return
	var/effect_icon = getNexusOpenCombatIcon(library_name)
	if(!effect_icon) return
	var/obj/Effect/effect = GetEffect()
	effect.icon = effect_icon
	effect.icon_state = effect_state
	effect.alpha = Clamp(effect_alpha, 1, 255)
	effect.blend_mode = effect_blend_mode
	effect.color = effect_color ? effect_color : null
	effect.SafeTeleport(target.base_loc())
	CenterIcon(effect)
	var/start_scale = max(0.1, effect_scale)
	effect.transform = matrix() * start_scale
	flick(effect_state, effect)
	if(growth) animate(effect, transform = matrix() * (start_scale + growth), time = max(1, hold_ticks), easing = SINE_EASING)
	sleep(max(1, hold_ticks))
	if(effect) animate(effect, alpha = 0, time = 4, easing = SINE_EASING)
	sleep(5)
	if(effect) del(effect)

proc/getNexusBeamImpactState()
	return pick("explosion1", "explosion2", "explosion3", "explosion4", "explosion5")
