"bp" = (/obj/EarthDirectory{directions_text = "Public wards north and south. Reception is through the open central corridor. Arrival park north; pharmacy across the road."; name = "Hospital directory"},/turf/EarthFloor/Clinic,/area/CityInterior/Earth)
"bq" = (/obj/EarthDirectory{directions_text = "Town hall and civic square. Hospital northwest; shops south; garage southwest. River crossings connect both banks."; name = "Civic district routes"},/turf/EarthFloor,/area/CityInterior/Earth)
"br" = (/obj/EarthDirectory{directions_text = "Welcome to the western city. Hospital south; residential streets north; civic center southeast. The open lawn east is reserved for planetary arrivals."; name = "Arrival park routes"},/turf/EarthFloor,/area/CityInterior/Earth)
