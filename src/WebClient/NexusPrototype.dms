<!--
  Diagnostic WebClient skin. Do not enable this file until the automatic UI.dmf
  conversion has been tested: the production interface references many controls
  that intentionally do not exist in this minimal compatibility fixture.
-->
<style>
html, body, #skin {
	width: 100%;
	height: 100%;
	margin: 0;
	overflow: hidden;
	color: #ead7b0;
	background: #080b10;
	font-family: sans-serif;
}
#nexus-layout {
	display: grid;
	grid-template-columns: minmax(0, 3fr) minmax(280px, 1fr);
	grid-template-rows: minmax(0, 1fr) auto;
	width: 100%;
	height: 100%;
}
#mapwindow\.map { grid-column: 1; grid-row: 1 / 3; min-width: 0; min-height: 0; }
#infowindow\.info { grid-column: 2; grid-row: 1; min-height: 0; overflow: auto; }
#nexuschatwindow\.command { grid-column: 2; grid-row: 2; min-width: 0; }
.byond_map { background: #000; }
.byond_info { border-left: 1px solid #5f5136; background: #111722; }
.byond_input { padding: 8px; color: #fff4dc; border: 1px solid #5f5136; background: #080b10; }
</style>

<div id="nexus-layout">
	<div id="mapwindow.map" byondclass="map"></div>
	<div id="infowindow.info" byondclass="info"></div>
	<div id="nexuschatwindow.command" byondclass="input"></div>
</div>

macro
	West+REP return ".west"
	West+UP return "WestReleased"
	East+REP return ".east"
	East+UP return "EastReleased"
	North+REP return ".north"
	North+UP return "NorthReleased"
	South+REP return ".south"
	South+UP return "SouthReleased"
	Northwest+REP return ".northwest"
	Northeast+REP return ".northeast"
	Southwest+REP return ".southwest"
	Southeast+REP return ".southeast"
	CTRL+NORTH return ".lookN"
	CTRL+SOUTH return ".lookS"
	CTRL+EAST return ".lookE"
	CTRL+WEST return ".lookW"
